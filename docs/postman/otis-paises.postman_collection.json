        {
          "name": "Eliminar país con departamentos (debe dar 409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paises/{{paisId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "paises",
                "{{paisId}}"
              ]
            },
            "description": "No se puede eliminar un registro que aún tiene dependientes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
