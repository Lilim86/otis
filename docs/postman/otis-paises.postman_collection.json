{
  "info": {
    "name": "OTIS - API Países",
    "description": "Pruebas de /api/paises. Ejecuta primero la carpeta '0. Sesión' (login por token Bearer). Requiere el backend corriendo en {{baseUrl}} (php artisan serve).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "12345678"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "paisId",
      "value": ""
    },
    {
      "key": "paisNombre",
      "value": ""
    },
    {
      "key": "deptoId",
      "value": ""
    },
    {
      "key": "deptoNombre",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Sesión (ejecutar primero)",
      "item": [
        {
          "name": "1. Login (obtiene el token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Devuelve un token Bearer', () => { pm.expect(j.token).to.be.a('string'); pm.expect(j.token_type).to.eql('Bearer'); });",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Usuario actual",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el usuario esperado', () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('username')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Países (/api/paises)",
      "item": [
        {
          "name": "Listar (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paises?page=1&per_page=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "paises"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Trae data y meta de paginación', () => { pm.expect(j.data).to.be.an('array'); pm.expect(j.meta).to.have.property('total'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar con búsqueda",
