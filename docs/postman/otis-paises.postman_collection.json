                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('paisId', d.id);",
                  "pm.test('Nace activo y registra quién lo creó', () => { pm.expect(d.estado).to.eql(true); pm.expect(d.creado_por).to.be.a('number'); });"
                ]
