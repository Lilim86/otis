# Copia este archivo como .env (en la raíz del proyecto) para Docker Compose.
# Usa las mismas credenciales que DB_* de backend/.env.
DB_DATABASE=otis
DB_USERNAME=postgres
DB_PASSWORD=cambia-esta-clave
# Puerto de tu PC donde escucha el PostgreSQL del contenedor (el 5432 lo usa el PostgreSQL instalado)
DB_PUERTO_DOCKER=5433
ADMINER_PUERTO=8080
